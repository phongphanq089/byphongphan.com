{
  "name": "byphongphan.com",
  "version": "0.1.0",
  "description": "High-craft developer portfolio & shadcn-compatible UI registry built natively with TanStack Start, React 19, and Tailwind CSS v4.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "homepage": "https://byphongphan.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phongphanq089/byphongphan.com.git"
  },
  "bugs": {
    "url": "https://github.com/phongphanq089/byphongphan.com/issues"
  },
  "author": "Phong Phan <phongphanq089@gmail.com> (https://byphongphan.com)",
  "license": "MIT",
  "keywords": [
    "tanstack-start",
    "react-19",
    "tailwindcss-v4",
    "shadcn-registry",
    "design-system",
    "creative-developer",
    "ui-engineering",
    "motion",
    "typescript"
  ],
  "scripts": {
    "dev": "vite dev --port 5731  --host",
    "build": "pnpm build:registry && pnpm type-check && vite build",
    "preview": "vite preview --port 5731",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "type-check": "tsc -b --noEmit",
    "prepare": "husky",
    "build:registry": "tsx scripts/build-registry.ts",
    "dev:force": "vite --force",
    "clean:vite": "node -e \"fs.rmSync('node_modules/.vite', { recursive: true, force: true })\""
  },
