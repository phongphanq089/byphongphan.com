  "files": [
    {
      "path": "animated/phong-phan-isometric.tsx",
      "content": "\"use client\"\n\nimport type { Transition } from \"framer-motion\"\nimport {\n  motion,\n  useInView,\n  useMotionValue,\n  useReducedMotion,\n  useSpring,\n  useTransform,\n} from \"framer-motion\"\nimport { useEffect, useId, useRef } from \"react\"\n\nimport { useSound } from \"@/hooks/use-sound\"\nimport { uMiniMapOpenSound } from \"@/lib/utils/u-mini-map-open\"\n\nconst transition: Transition = {\n  type: \"spring\",\n  mass: 0.5,\n  damping: 18,\n  stiffness: 200,\n}\n\nexport type PhongPhanVariant = \"full\" | \"padded\"\n\nexport interface PhongPhanIsometricProps {\n  className?: string\n  showGrid?: boolean\n  showCrosshairs?: boolean\n  /**\n   * Layout padding variant:\n   * - \"full\" (default): Edge-to-edge typography with 0px horizontal padding\n   * - \"padded\": Typography framed with horizontal buffer padding\n   */\n  variant?: PhongPhanVariant\n  /**\n   * Quick toggle: set true for padded, false for full edge-to-edge\n   */\n  padding?: boolean\n  enableSound?: boolean\n}\n\n/**\n * Phong Phan 3D Horizontal Block Typography\n * Horizontal layout with 3D extruded block volume, diagonal hatching pattern,\n * wireframe outlines, interactive radial flashlight, full/padded variants, and spring physics.\n */\nexport function PhongPhanIsometric({\n  className,\n  showGrid = true,\n  variant = \"full\",\n  padding,\n  enableSound = true,\n}: PhongPhanIsometricProps) {\n  const id = useId()\n  const ids = {\n    facePattern: `pp-3d-face-pattern-${id}`,\n    frontFill: `pp-3d-front-fill-${id}`,\n    stroke: `pp-3d-stroke-${id}`,\n    radialGradient: `pp-3d-radial-gradient-${id}`,\n  }\n\n  const isFull = padding === undefined ? variant === \"full\" : !padding\n  const viewBox = isFull ? \"0 0 1054 198\" : \"-80 0 1214 198\"\n  const widthBoundMin = isFull ? 0 : -80\n  const widthBoundMax = isFull ? 1054 : 1134\n\n  const ref = useRef<SVGSVGElement>(null)\n  const [play] = useSound(uMiniMapOpenSound, { volume: 0.3, soundEnabled: enableSound })\n\n  const shouldReduceMotion = useReducedMotion()\n  const isInView = useInView(ref, { margin: \"80px\" })\n\n  const mouseX = useMotionValue(0.5)\n  const mouseY = useMotionValue(0.5)\n\n  const cx = useSpring(\n    useTransform(mouseX, [0, 1], [widthBoundMin, widthBoundMax]),\n    {\n      stiffness: 300,\n      damping: 30,\n      mass: 0.1,\n    }\n  )\n\n  const cy = useSpring(useTransform(mouseY, [0, 1], [0, 198]), {\n    stiffness: 300,\n    damping: 30,\n    mass: 0.1,\n  })\n\n  useEffect(() => {\n    if (shouldReduceMotion || !isInView) return\n    if (typeof window !== \"undefined\" && window.matchMedia(\"(hover: none)\").matches) return\n\n    const handleMouseMove = (e: MouseEvent) => {\n      if (!ref.current) return\n      const rect = ref.current.getBoundingClientRect()\n      mouseX.set((e.clientX - rect.left) / rect.width)\n      mouseY.set((e.clientY - rect.top) / rect.height)\n    }\n\n    window.addEventListener(\"mousemove\", handleMouseMove)\n    return () => window.removeEventListener(\"mousemove\", handleMouseMove)\n  }, [shouldReduceMotion, isInView, mouseX, mouseY])\n\n  return (\n    <motion.svg\n      ref={ref}\n      width=\"100%\"\n      preserveAspectRatio=\"xMidYMid meet\"\n      className={`block h-auto w-full cursor-pointer touch-manipulation overflow-visible select-none [--pattern:color-mix(in_oklab,var(--foreground)_14%,transparent)] [--stroke:color-mix(in_oklab,var(--foreground)_22%,transparent)] ${className ?? \"\"}`}\n      viewBox={viewBox}\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-label=\"PHONG PHAN 3D Block Typography\"\n      initial=\"normal\"\n      whileTap=\"pressed\"\n      onTap={() => {\n        if (enableSound) play()\n      }}\n    >\n      <defs>\n        {/* Diagonal Hatching Pattern */}\n        <pattern\n          id={ids.facePattern}\n          x=\"0\"\n          y=\"0\"\n          width=\"10\"\n          height=\"10\"\n          patternUnits=\"userSpaceOnUse\"\n        >\n          <path\n            d=\"M-1 1l2 -2M0 10l10 -10M9 11l2 -2\"\n            stroke=\"var(--pattern)\"\n            strokeWidth=\"1.2\"\n          />\n        </pattern>\n\n        {/* Front Faces with interactive press displacement */}\n        <motion.g\n          id={ids.frontFill}\n          variants={{\n            normal: {\n              transform: \"translate(0px, 0px)\",\n            },\n            pressed: {\n              transform: \"translate(6px, -6px)\",\n            },\n          }}\n          transition={transition}\n        >\n          <path\n            d=\"M0.00 42.00L86.00 42.00L86.00 115.44L26.00 115.44L26.00 178.00L0.00 178.00Z M26.00 68.00L60.00 68.00L60.00 89.44L26.00 89.44Z\"\n            fillRule=\"evenodd\"\n            clipRule=\"evenodd\"\n          />\n          <path\n            d=\"M108.00 42.00L134.00 42.00L134.00 97.00L170.00 97.00L170.00 42.00L196.00 42.00L196.00 178.00L170.00 178.00L170.00 123.00L134.00 123.00L134.00 178.00L108.00 178.00Z\"\n            fillRule=\"evenodd\"\n            clipRule=\"evenodd\"\n          />\n          <path\n            d=\"M218.00 42.00L306.00 42.00L306.00 178.00L218.00 178.00Z M244.00 68.00L280.00 68.00L280.00 152.00L244.00 152.00Z\"\n            fillRule=\"evenodd\"\n            clipRule=\"evenodd\"\n          />\n          <path\n            d=\"M328.00 42.00L354.00 42.00L394.00 139.92L394.00 42.00L420.00 42.00L420.00 178.00L394.00 178.00L354.00 80.08L354.00 178.00L328.00 178.00Z\"\n            fillRule=\"evenodd\"\n            clipRule=\"evenodd\"\n          />\n          <path\n            d=\"M442.00 42.00L530.00 42.00L530.00 68.00L468.00 68.00L468.00 152.00L504.00 152.00L504.00 123.00L492.00 123.00L492.00 97.00L530.00 97.00L530.00 178.00L442.00 178.00Z\"\n            fillRule=\"evenodd\"\n            clipRule=\"evenodd\"\n          />\n          <path\n            d=\"M612.00 42.00L698.00 42.00L698.00 115.44L638.00 115.44L638.00 178.00L612.00 178.00Z M638.00 68.00L672.00 68.00L672.00 89.44L638.00 89.44Z\"\n            fillRule=\"evenodd\"\n            clipRule=\"evenodd\"\n          />\n          <path\n            d=\"M720.00 42.00L746.00 42.00L746.00 97.00L782.00 97.00L782.00 42.00L808.00 42.00L808.00 178.00L782.00 178.00L782.00 123.00L746.00 123.00L746.00 178.00L720.00 178.00Z\"\n            fillRule=\"evenodd\"\n            clipRule=\"evenodd\"\n          />\n          <path\n            d=\"M830.00 42.00L918.00 42.00L918.00 178.00L892.00 178.00L892.00 133.88L856.00 133.88L856.00 178.00L830.00 178.00Z M856.00 68.00L892.00 68.00L892.00 107.88L856.00 107.88Z\"\n            fillRule=\"evenodd\"\n            clipRule=\"evenodd\"\n          />\n          <path\n            d=\"M940.00 42.00L966.00 42.00L1006.00 139.92L1006.00 42.00L1032.00 42.00L1032.00 178.00L1006.00 178.00L966.00 80.08L966.00 178.00L940.00 178.00Z\"\n            fillRule=\"evenodd\"\n            clipRule=\"evenodd\"\n          />\n        </motion.g>\n\n        {/* Stroke outlines with normal and pressed wireframe edges */}\n        <motion.path\n          id={ids.stroke}\n          variants={{\n            normal: {\n              d: \"M0.00 42.00L86.00 42.00M0.00 42.00L22.00 20.00M86.00 42.00L108.00 20.00M22.00 20.00L108.00 20.00M86.00 42.00L86.00 115.44M86.00 42.00L108.00 20.00M86.00 115.44L108.00 93.44M108.00 20.00L108.00 93.44M86.00 115.44L26.00 115.44M26.00 115.44L26.00 178.00M26.00 115.44L48.00 93.44M26.00 178.00L48.00 156.00M48.00 93.44L48.00 156.00M26.00 178.00L0.00 178.00M0.00 178.00L0.00 42.00M26.00 68.00L60.00 68.00M26.00 68.00L48.00 46.00M60.00 68.00L82.00 46.00M48.00 46.00L82.00 46.00M60.00 68.00L60.00 89.44M60.00 68.00L82.00 46.00M60.00 89.44L82.00 67.44M82.00 46.00L82.00 67.44M60.00 89.44L26.00 89.44M26.00 89.44L26.00 68.00M108.00 42.00L134.00 42.00M108.00 42.00L130.00 20.00M134.00 42.00L156.00 20.00M130.00 20.00L156.00 20.00M134.00 42.00L134.00 97.00M134.00 42.00L156.00 20.00M134.00 97.00L156.00 75.00M156.00 20.00L156.00 75.00M134.00 97.00L170.00 97.00M134