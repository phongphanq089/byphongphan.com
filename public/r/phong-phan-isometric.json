{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "phong-phan-isometric",
  "type": "registry:component",
  "title": "Isometric Block Typography",
  "description": "Horizontal 3D block typography extruded along an isometric blueprint grid, equipped with interactive dynamic lighting, sound feedback, and edge-to-edge/padded layout variants.",
